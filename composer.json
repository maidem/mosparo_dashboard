{
    "name": "maidem/mosparo-dashboard",
    "type": "typo3-cms-extension",
    "description": "TYPO3 dashboard widgets showing mosparo spam-protection statistics (valid/spam submissions) via the mosparo API.",
    "homepage": "https://maidem.de",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3 CMS",
        "mosparo",
        "dashboard"
    ],
    "require": {
        "php": ">=8.2",
        "typo3/cms-core": "^14.1",
        "typo3/cms-dashboard": "^14.1",
        "psr/log": "^3.0",
        "mosparo/php-api-client": "^1.0 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Maidem\\MosparoDashboard\\": "Classes/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mosparo_dashboard"
        }
    }
}
